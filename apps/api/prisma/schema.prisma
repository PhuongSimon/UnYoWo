generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  fullName        String    @map("full_name")
  passwordHash    String?   @map("password_hash")
  googleId        String?   @unique @map("google_id")
  avatarUrl       String?   @map("avatar_url")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  /// IANA zone (e.g. Asia/Ho_Chi_Minh): decides where the user's "today" starts for streaks and daily goals.
  timezone        String    @default("UTC")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  itemProgress  UserItemProgress[]

  @@map("users")
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  email       String
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  resetUsedAt DateTime?  @map("reset_used_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([email, purpose, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Learning content ────────────────────────────────────────────────────────
// Shared by every user. Games never read these tables directly: they ask the
// content module for items, so adding a language only means adding seed data.

enum LearningSetKind {
  ALPHABET
  VOCABULARY
}

enum LearningItemType {
  /// One letter, kana or jamo: あ, ㄱ
  CHARACTER
  /// A unit built from components: 가, きゃ, が
  SYLLABLE
  WORD
}

enum ComponentRole {
  /// Hangul syllable block parts
  INITIAL
  VOWEL
  FINAL
  /// Kana: the main character, a small ゃゅょ, or the ゛ ゜ marks
  BASE
  SMALL
  MARK
}

enum ItemRelationKind {
  /// あ ↔ ア (stored in both directions)
  SCRIPT_COUNTERPART
  /// か → が
  VOICED
  /// は → ぱ
  SEMI_VOICED
  /// さ ↔ き: curated look-alikes used as distractors (stored in both directions)
  CONFUSABLE
}

model Language {
  /// BCP 47 primary tag: en, de, ja, ko
  code       String   @id
  nativeName String   @map("native_name")
  /// Voice tag for speech synthesis: ja-JP
  speechLang String   @map("speech_lang")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  sets LearningSet[]

  @@map("languages")
}

/// The unit a user picks to study and the unit achievements refer to: "Hiragana: basic", "German: food".
model LearningSet {
  id           String          @id @default(uuid()) @db.Uuid
  languageCode String          @map("language_code")
  slug         String
  kind         LearningSetKind
  /// Writing system for alphabet sets: hiragana, katakana, hangul
  script       String?
  /// Topic for vocabulary sets (food, animals…), shared across languages to group sets
  category     String?
  /// { en, vi }
  title        Json
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  language Language       @relation(fields: [languageCode], references: [code])
  items    LearningItem[]

  @@unique([languageCode, slug])
  @@map("learning_sets")
}

/// A meaning shared across languages: apple ↔ Apfel ↔ りんご ↔ 사과.
model Concept {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  /// { en, vi }: the meaning shown in the learner's UI language
  gloss     Json
  emoji     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items LearningItem[]

  @@map("concepts")
}

model LearningItem {
  id              String           @id @default(uuid()) @db.Uuid
  setId           String           @map("set_id") @db.Uuid
  type            LearningItemType
  /// What the learner sees in the target language: ぬ, 가, Apfel, 犬
  text            String
  /// Kana reading for words written with kanji: 犬 → いぬ
  reading         String?
  romanization    String?
  ipa             String?
  /// Other spellings accepted when typing: shi → si, tsu → tu
  acceptedAnswers String[]         @default([]) @map("accepted_answers")
  conceptId       String?          @map("concept_id") @db.Uuid
  /// Language-specific extras, e.g. German { gender, article }
  attributes      Json?
  /// Recorded audio; when empty the web app falls back to speech synthesis
  audioUrl        String?          @map("audio_url")
  /// 1 (easiest) to 5
  difficulty      Int              @default(1) @db.SmallInt
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  set         LearningSet        @relation(fields: [setId], references: [id], onDelete: Cascade)
  concept     Concept?           @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  components  ItemComponent[]    @relation("ItemComponents")
  partOf      ItemComponent[]    @relation("ComponentItem")
  relations   ItemRelation[]     @relation("RelationFrom")
  relatedFrom ItemRelation[]     @relation("RelationTo")
  progress    UserItemProgress[]

  @@unique([setId, text])
  @@index([conceptId])
  @@map("learning_items")
}

/// Keeps how a syllable is built: 곡 = ㄱ (INITIAL) + ㅗ (VOWEL) + ㄱ (FINAL), きゃ = き (BASE) + ゃ (SMALL).
model ItemComponent {
  itemId          String        @map("item_id") @db.Uuid
  position        Int           @db.SmallInt
  role            ComponentRole
  text            String
  /// Set when the component is itself a learning item (ㄱ, き); null for marks like ゛
  componentItemId String?       @map("component_item_id") @db.Uuid

  item          LearningItem  @relation("ItemComponents", fields: [itemId], references: [id], onDelete: Cascade)
  componentItem LearningItem? @relation("ComponentItem", fields: [componentItemId], references: [id], onDelete: SetNull)

  @@id([itemId, position])
  @@index([componentItemId])
  @@map("item_components")
}

model ItemRelation {
  itemId        String           @map("item_id") @db.Uuid
  relatedItemId String           @map("related_item_id") @db.Uuid
  kind          ItemRelationKind

  item        LearningItem @relation("RelationFrom", fields: [itemId], references: [id], onDelete: Cascade)
  relatedItem LearningItem @relation("RelationTo", fields: [relatedItemId], references: [id], onDelete: Cascade)

  @@id([itemId, relatedItemId, kind])
  @@index([relatedItemId])
  @@map("item_relations")
}

// ─── Progress ────────────────────────────────────────────────────────────────

/// One row per (user, item) once the user has met the item. Accuracy and the
/// incorrect count are derived from attempt_count / correct_count, not stored.
model UserItemProgress {
  userId          String    @map("user_id") @db.Uuid
  itemId          String    @map("item_id") @db.Uuid
  attemptCount    Int       @default(0) @map("attempt_count")
  correctCount    Int       @default(0) @map("correct_count")
  /// Correct answers in a row; resets to 0 on a mistake
  correctStreak   Int       @default(0) @map("correct_streak")
  /// 0 (new) to 5, decided by the review scheduler
  masteryLevel    Int       @default(0) @map("mastery_level") @db.SmallInt
  intervalMinutes Int       @default(0) @map("interval_minutes")
  lastReviewedAt  DateTime? @map("last_reviewed_at")
  dueAt           DateTime? @map("due_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item LearningItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@index([userId, dueAt])
  @@index([itemId])
  @@map("user_item_progress")
}
