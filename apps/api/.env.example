# Copy to .env and adjust. Never commit .env.

PORT=3000
NODE_ENV=development

# Public URL of the web app (used for redirects after Google sign-in)
WEB_URL=http://localhost:5173

DATABASE_URL=postgresql://unyowo:unyowo@localhost:5433/unyowo

# Generate strong secrets: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_RESET_SECRET=change-me-reset-secret
REFRESH_TOKEN_TTL_DAYS=30

OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Cloudflare Turnstile secret. Test secret that always passes:
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Mailpit (docker compose) catches all mail in dev: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UnYoWo <no-reply@unyowo.local>"

# Google OAuth (leave empty to disable). Redirect URI must be registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
