# Copy file này thành .env.local rồi điền giá trị thật.
# Chỉ biến có tiền tố VITE_ mới đọc được trong code FE (import.meta.env.VITE_...).
# Mọi biến VITE_ đều bị đóng gói vào JS gửi xuống browser → KHÔNG để secret ở đây.

VITE_API_URL=/api

# Cloudflare Turnstile – site key (public). Key test luôn pass: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
